-- ================= ANIMATION LOOP =================
local displayPct, targetPct = 0, 0
local t0 = os.clock()
local pingTimer = 0
local finished = false

local conn
conn = RunService.RenderStepped:Connect(function(dt)
    local t = os.clock() - t0

    -- smooth progress
    displayPct += (targetPct - displayPct) * math.min(1, dt * 4)
    barFill.Size = UDim2.fromScale(math.clamp(displayPct / 100, 0, 1), 1)
    percentLabel.Text = string.format("%d%%", math.floor(displayPct + 0.5))

    -- rotating gradients
    borderGrad.Rotation = (t * 90) % 360
    iconGrad.Rotation = (-t * 120) % 360
    spinGrad.Rotation = (t * 360) % 360
    titleGrad.Offset = Vector2.new(math.sin(t * 1.5) * 0.4, 0)

    -- shimmer sweep
    shimmerGrad.Offset = Vector2.new(((t * 0.8) % 2) - 1, 0)

    -- floating card
    cardHolder.Position = UDim2.new(0.5, 0, 0.5, math.sin(t * 1.6) * 5)

    -- particles
    for _, p in ipairs(particles) do
        p.x += p.vx * dt
        p.y += p.vy * dt
        if p.y < -0.02 then p.y = 1.02 p.x = math.random() end
        if p.x < 0 then p.x = 1 elseif p.x > 1 then p.x = 0 end
        p.frame.Position = UDim2.fromScale(p.x, p.y)
    end

    -- ping
    pingTimer += dt
    if pingTimer > 1 then
        pingTimer = 0
        local ok, ping = pcall(function() return player:GetNetworkPing() * 1000 end)
        if ok then pingLabel.Text = string.format("%d ms", math.floor(ping)) end
    end
end)

-- ================= SEQUENCE =================
task.spawn(function()
    -- intro
    TweenService:Create(root, TweenInfo.new(0.6), { GroupTransparency = 0 }):Play()
    TweenService:Create(cardScale, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
    task.wait(0.7)

    addLog("[SYSTEM] Cold-starting Nero Script...", Color3.fromRGB(192, 132, 252))

    local weights = { 1, 1.1, 1.5, 1.6, 1.2, 0.6 }
    local totalW = 0
    for _, w in ipairs(weights) do totalW += w end

    for i, step in ipairs(STAGES) do
        stageLabel.Text = step.stage
        addLog(step.log, step.color)
        targetPct = step.pct
        task.wait(CONFIG.TotalTime * weights[i] / totalW)
    end

    -- done state
    stageLabel.Text = "READY"
    spinner.Visible = false
    stageLabel.Position = UDim2.fromOffset(0, 0)
    stageLabel.TextColor3 = COLORS.Green
    task.wait(1)

    -- outro
    finished = true
    TweenService:Create(cardScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0.8 }):Play()
    local fade = TweenService:Create(root, TweenInfo.new(0.5), { GroupTransparency = 1 })
    fade:Play()
    fade.Completed:Wait()

    conn:Disconnect()
    gui:Destroy()
    onFinished()
end)
