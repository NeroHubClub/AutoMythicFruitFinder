local logOrder = 0
local function addLog(text, color)
    logOrder += 1
    local line = make("TextLabel", {
        Size = UDim2.new(1, 0, 0, 15),
        LayoutOrder = logOrder,
        BackgroundTransparency = 1,
        Text = text,
        Font = Enum.Font.Code,
        TextSize = 12,
        TextColor3 = color or COLORS.Muted,
        TextTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, logHolder)
    TweenService:Create(line, TweenInfo.new(0.25), { TextTransparency = 0 }):Play()

    local children = {}
    for _, c in ipairs(logHolder:GetChildren()) do
        if c:IsA("TextLabel") then table.insert(children, c) end
    end
    table.sort(children, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
    while #children > 5 do
        table.remove(children, 1):Destroy()
    end
end

